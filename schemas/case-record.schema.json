{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskgenome-bench.local/schemas/case-record.schema.json",
  "title": "TaskGenome Bench case record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_protocol",
    "run_fingerprint",
    "trial_key",
    "task_id",
    "raw_response",
    "extracted_code"
  ],
  "properties": {
    "schema_version": {
      "const": "taskgenome.case.v1"
    },
    "runtime_protocol": {
      "enum": ["legacy-v1", "hardened-v2"]
    },
    "run_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "trial_key": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{4}$"
    },
    "raw_response": {
      "type": "string"
    },
    "extracted_code": {
      "type": "string"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
